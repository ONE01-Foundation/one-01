# ONE — environment variables
#
# Copy this file to .env and fill in your own values. NEVER commit .env.
# Only EXPO_PUBLIC_* values are exposed to the client; all others are
# backend-only.

# ─── Client (exposed to the app via expo-constants) ──────────────────────────
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_API_URL=http://localhost:3340

# ─── Backend only (never use in client code) ─────────────────────────────────
OPENAI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Optional: development overrides ─────────────────────────────────────────
NODE_ENV=development
PORT=3340
